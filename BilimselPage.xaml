<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesi.BilimselPage"
             Title="Bilimsel">

    <Grid RowDefinitions="2*,Auto,Auto,Auto,8*"
          Padding="{StaticResource SayfaDolgu}"
          RowSpacing="{StaticResource TusAraligi}">

        <!-- 1) EKRAN -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End">
            <Label x:Name="IfadeLabel" Style="{StaticResource EkranIfade}" />
            <Label x:Name="SonucLabel" Text="0" Style="{StaticResource EkranSonuc}" />
        </VerticalStackLayout>

        <!-- 2) AÇI BİRİMİ ve GÖSTERİM -->
        <HorizontalStackLayout Grid.Row="1" Spacing="{StaticResource TusAraligi}">
            <Button x:Name="AciButon" Text="DEG" Style="{StaticResource SecenekTus}" Clicked="Aci_Clicked"
                    SemanticProperties.Description="Açı birimini değiştir: derece, radyan, grad" />
            <Button x:Name="FeButon" Text="F-E" Style="{StaticResource SecenekTus}" Clicked="Gosterim_Clicked"
                    SemanticProperties.Description="Bilimsel gösterimi aç veya kapat" />
        </HorizontalStackLayout>

        <!-- 3) HAFIZA SATIRI -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="{StaticResource TusAraligi}">
            <Button x:Name="McButon" Text="MC" CommandParameter="MC" Style="{StaticResource HafizaTus}" Clicked="Hafiza_Clicked"
                    SemanticProperties.Description="Hafızayı temizle" />
            <Button x:Name="MrButon" Grid.Column="1" Text="MR" CommandParameter="MR" Style="{StaticResource HafizaTus}" Clicked="Hafiza_Clicked"
                    SemanticProperties.Description="Hafızadaki sayıyı getir" />
            <Button Grid.Column="2" Text="M+" CommandParameter="M+" Style="{StaticResource HafizaTus}" Clicked="Hafiza_Clicked"
                    SemanticProperties.Description="Hafızaya ekle" />
            <Button Grid.Column="3" Text="M−" CommandParameter="M-" Style="{StaticResource HafizaTus}" Clicked="Hafiza_Clicked"
                    SemanticProperties.Description="Hafızadan çıkar" />
            <Button Grid.Column="4" Text="MS" CommandParameter="MS" Style="{StaticResource HafizaTus}" Clicked="Hafiza_Clicked"
                    SemanticProperties.Description="Hafızaya kaydet" />
        </Grid>

        <!-- 4) TRİGONOMETRİ ve FONKSİYONLAR (örtük stil) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="{StaticResource TusAraligi}">
            <Button x:Name="SinButon" Text="sin" CommandParameter="sin" Clicked="Tekli_Clicked" SemanticProperties.Description="Sinüs" />
            <Button x:Name="CosButon" Grid.Column="1" Text="cos" CommandParameter="cos" Clicked="Tekli_Clicked" SemanticProperties.Description="Kosinüs" />
            <Button x:Name="TanButon" Grid.Column="2" Text="tan" CommandParameter="tan" Clicked="Tekli_Clicked" SemanticProperties.Description="Tanjant" />
            <Button Grid.Column="3" Text="⌊x⌋" CommandParameter="taban" Clicked="Tekli_Clicked" SemanticProperties.Description="Aşağı yuvarla" />
            <Button Grid.Column="4" Text="⌈x⌉" CommandParameter="tavan" Clicked="Tekli_Clicked" SemanticProperties.Description="Yukarı yuvarla" />
        </Grid>

        <!-- 5) ANA TUŞ TAKIMI: 7 satır × 5 sütun -->
        <Grid Grid.Row="4"
              RowDefinitions="*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*"
              RowSpacing="{StaticResource TusAraligi}" ColumnSpacing="{StaticResource TusAraligi}">

            <!-- Satır 0 -->
            <Button x:Name="IkinciButon" Text="2nd" Clicked="Ikinci_Clicked" SemanticProperties.Description="İkinci işlevler" />
            <Button Grid.Column="1" Text="π" CommandParameter="pi" Clicked="Sabit_Clicked" SemanticProperties.Description="Pi sayısı" />
            <Button Grid.Column="2" Text="e" CommandParameter="e" Clicked="Sabit_Clicked" SemanticProperties.Description="Euler sayısı" />
            <Button Grid.Column="3" Text="C" Clicked="Temizle_Clicked" SemanticProperties.Description="Tümünü temizle" />
            <Button Grid.Column="4" Text="⌫" Clicked="GeriSil_Clicked" SemanticProperties.Description="Son rakamı sil" />

            <!-- Satır 1 -->
            <Button x:Name="KareButon" Grid.Row="1" Text="x²" CommandParameter="kare" Clicked="Tekli_Clicked" SemanticProperties.Description="Kare" />
            <Button Grid.Row="1" Grid.Column="1" Text="1/x" CommandParameter="tersi" Clicked="Tekli_Clicked" SemanticProperties.Description="Çarpmaya göre ters" />
            <Button Grid.Row="1" Grid.Column="2" Text="|x|" CommandParameter="mutlak" Clicked="Tekli_Clicked" SemanticProperties.Description="Mutlak değer" />
            <Button Grid.Row="1" Grid.Column="3" Text="exp" Clicked="Us_Clicked" SemanticProperties.Description="Bilimsel üs girişi" />
            <Button Grid.Row="1" Grid.Column="4" Text="mod" CommandParameter="mod" Clicked="Islem_Clicked" SemanticProperties.Description="Mod, bölümden kalan" />

            <!-- Satır 2 -->
            <Button x:Name="KokButon" Grid.Row="2" Text="²√x" CommandParameter="karekok" Clicked="Tekli_Clicked" SemanticProperties.Description="Karekök" />
            <Button x:Name="ParantezAcButon" Grid.Row="2" Grid.Column="1" Text="(" CommandParameter="(" Clicked="Parantez_Clicked" SemanticProperties.Description="Parantez aç" />
            <Button Grid.Row="2" Grid.Column="2" Text=")" CommandParameter=")" Clicked="Parantez_Clicked" SemanticProperties.Description="Parantez kapat" />
            <Button Grid.Row="2" Grid.Column="3" Text="n!" CommandParameter="faktoriyel" Clicked="Tekli_Clicked" SemanticProperties.Description="Faktöriyel" />
            <Button Grid.Row="2" Grid.Column="4" Text="÷" CommandParameter="/" Style="{StaticResource IslemTus}" Clicked="Islem_Clicked" SemanticProperties.Description="Bölme" />

            <!-- Satır 3 -->
            <Button Grid.Row="3" Text="xʸ" CommandParameter="^" Clicked="Islem_Clicked" SemanticProperties.Description="Üs alma" />
            <Button Grid.Row="3" Grid.Column="1" Text="7" CommandParameter="7" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="8" CommandParameter="8" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="9" CommandParameter="9" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="3" Grid.Column="4" Text="×" CommandParameter="*" Style="{StaticResource IslemTus}" Clicked="Islem_Clicked" SemanticProperties.Description="Çarpma" />

            <!-- Satır 4 -->
            <Button x:Name="OnUsButon" Grid.Row="4" Text="10ˣ" CommandParameter="on_us" Clicked="Tekli_Clicked" SemanticProperties.Description="10 üzeri x" />
            <Button Grid.Row="4" Grid.Column="1" Text="4" CommandParameter="4" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="5" CommandParameter="5" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="6" CommandParameter="6" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="4" Grid.Column="4" Text="−" CommandParameter="-" Style="{StaticResource IslemTus}" Clicked="Islem_Clicked" SemanticProperties.Description="Çıkarma" />

            <!-- Satır 5 -->
            <Button Grid.Row="5" Text="log" CommandParameter="log" Clicked="Tekli_Clicked" SemanticProperties.Description="10 tabanında logaritma" />
            <Button Grid.Row="5" Grid.Column="1" Text="1" CommandParameter="1" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="5" Grid.Column="2" Text="2" CommandParameter="2" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="5" Grid.Column="3" Text="3" CommandParameter="3" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="5" Grid.Column="4" Text="+" CommandParameter="+" Style="{StaticResource IslemTus}" Clicked="Islem_Clicked" SemanticProperties.Description="Toplama" />

            <!-- Satır 6 -->
            <Button x:Name="LnButon" Grid.Row="6" Text="ln" CommandParameter="ln" Clicked="Tekli_Clicked" SemanticProperties.Description="Doğal logaritma" />
            <Button Grid.Row="6" Grid.Column="1" Text="+/−" Style="{StaticResource RakamTus}" Clicked="Isaret_Clicked" SemanticProperties.Description="İşaret değiştir" />
            <Button Grid.Row="6" Grid.Column="2" Text="0" CommandParameter="0" Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" />
            <Button Grid.Row="6" Grid.Column="3" Text="," CommandParameter="," Style="{StaticResource RakamTus}" Clicked="Rakam_Clicked" SemanticProperties.Description="Ondalık virgül" />
            <Button Grid.Row="6" Grid.Column="4" Text="=" Style="{StaticResource EsittirTus}" Clicked="Esittir_Clicked" SemanticProperties.Description="Eşittir" />
        </Grid>
    </Grid>
</ContentPage>